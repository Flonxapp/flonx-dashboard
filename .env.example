# Copy to .env.local for local development. In production these come from
# the ENV_VARS_JSON GitHub secret (see .github/workflows/deploy.yml).
# Values are baked into the bundle at build time; never put secrets here.

# Backend base URL (without /api/v1)
VITE_API_URL=https://api.flonxapp.com

# Google Maps JavaScript API key with the Places library (venue address).
# Restrict it to your dashboard domains in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# Customer app (progressive app) URL, used in the venue QR code link
VITE_CUSTOMER_APP_URL=https://flonx-progressive-web-client.vercel.app
